# ===== LLM（OpenAI 兼容协议，任选一家；不填则自动 mock 模式，零配置可跑） =====
# DeepSeek: https://api.deepseek.com/v1 + deepseek-chat
# 智谱GLM: https://open.bigmodel.cn/api/paas/v4 + glm-4-air
# 硅基流动: https://api.siliconflow.cn/v1 + Qwen/Qwen2.5-32B-Instruct
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ===== Embedding（留空复用 LLM 配置；推荐硅基流动 bge-m3，免费额度充足） =====
EMBED_API_BASE=https://api.siliconflow.cn/v1
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-m3

# ===== Rerank（可选；不填自动跳过，检索降级为 RRF 融合序） =====
RERANK_API_BASE=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== 检索/编排调参（评测对比用，见 docs/eval_report.md） =====
# CHUNK_SIZE=450
# TOP_K_FINAL=5
# GRADE_THRESHOLD=0.5
# MAX_QUERY_REWRITES=2
